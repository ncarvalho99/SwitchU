# Build outputs
build_switch/
*.elf
*.nro
*.nacp
*.nsp
*.zip
*.log
sd_out/
build/
build_nro/
.vscode/
.xmake/
.DS_Store
Thumbs.db
compile_commands.json

# Keep the local ulaunch checkout out of this repository.
/ulaunch/

# Local reference builds kept side by side for comparison, and saved CI logs.
/.compilado_autor/
/.compilado_fork/
/.logs/

# Manually fetched toolchain packages, kept out of the tree.
/.download/

# Staging area for assets and ideas waiting to be implemented. What gets
# implemented is committed from wherever it belongs in the tree; this folder
# itself never is.
/.features/

# Install layout and packaged zip produced by .logs/build-local.ps1, the same
# two the CI workflow builds and uploads as artifacts.
/dist/
/artifacts/

# Regenerated frame sources and Python bytecode used while authoring animated
# theme assets. The committed DDS frames live under romfs/themes instead.
/fps/
tools/__pycache__/

# Local hbloader experiments; the project does not consume these binaries.
/lib/switchu-hbloader/
