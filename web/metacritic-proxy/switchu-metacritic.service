[Unit]
Description=SwitchU Metacritic score bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=switchu-metacritic
Group=switchu-metacritic
WorkingDirectory=/opt/switchu-metacritic
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=SWITCHU_METADATA_DB=/var/lib/switchu-metacritic/cache.sqlite3
Environment=SWITCHU_TRUSTED_NETWORKS=172.26.128.0/26,10.0.0.0/26,127.0.0.0/8,::1/128
EnvironmentFile=-/etc/switchu-metadata/igdb.env
UMask=0077
ExecStart=/usr/bin/python3 -m uvicorn metacritic_proxy:app --host 0.0.0.0 --port 8082 --no-proxy-headers
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/switchu-metacritic
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
